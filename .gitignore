node_modules/
dist/
.tingkebanlv/
*.pyc
__pycache__/
.env
*.egg-info/
.DS_Store
ecdict.db

# 本地保留的重复项目副本（不入库，避免仓库内两份代码）
tingke-banlv/

# electron-builder 构建产物（win-unpacked + 安装包，体积可达数百 MB）
release/
frontend/release/

# 词表扩充过程的批次临时文件备份（内容已合并进 basic_vocab.json）
backend/dictionary/_backup_batches/

# PyInstaller 冻结后端的产物与中间目录（packaging/out/backend-server 约 200MB）
packaging/out/
packaging/build/
# 重建前用来给旧产物「让位」的改名目录（PyInstaller 清空 dist 时会触发
# 沙箱的批量删除保护，所以改为先 mv 再建，这些是临时残留）
packaging/_stale_*/

# 实装验证报告（由 scripts/verify_install.py 生成）
packaging/verify/

# 内置模型种子（约 141MB 二进制，由 scripts/prepare_seed_model.py 生成，
# 不入库；构建前需先执行该脚本）
packaging/seed/
*.spec.bak

# 本地排障时的临时输出（构建/测试/冒烟转储，不入库）
_*.txt
.pytest_cache/

# 合成音频测试集（由 scripts/make_asr_testset.py 生成，约 24MB，可随时重建）
tests/audio/

# ASR 质量评估报告（由 scripts/eval_asr_quality.py 生成）
packaging/eval/
