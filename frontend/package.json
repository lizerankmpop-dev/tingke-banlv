{
  "name": "tingke-banlv-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "backend:build": "python -m PyInstaller ../packaging/backend_server.spec --noconfirm --distpath ../packaging/out --workpath ../packaging/build",
    "preflight:seed": "node scripts/preflight-seed.cjs",
    "package:win": "npm run preflight:seed && npm run build && npm run backend:build && electron-builder --win",
    "electron:build": "npm run preflight:seed && npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4",
    "dexie": "^4.0.4",
    "lucide-react": "^0.419.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "wait-on": "^7.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.tingkebanlv.app",
    "productName": "听课伴侣",
    "copyright": "Copyright © 2026 听课伴侣",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.pytest_cache/**",
          "!tests/**",
          "!dictionary/_backup_batches/**"
        ]
      },
      {
        "from": "../packaging/out/backend-server",
        "to": "backend-server",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../packaging/seed/whisper_models",
        "to": "whisper_models",
        "filter": [
          "**/*",
          "!**/.DS_Store",
          "!**/blobs/**"
        ]
      },
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "tingkebanlv-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "听课伴侣"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "tingkebanlv-${version}.${ext}"
    }
  }
}
